.{
    // URI/URL parsing and manipulation library for Zig
    // Implements: RFC 3986 (URI), RFC 8141 (URN)
    // Planned: RFC 3987 (IRI), RFC 6874 (IPv6 Zone ID), WHATWG URL Standard
    .name = .uri,

    // Semantic versioning - https://semver.org/
    .version = "0.1.6",

    // Unique package fingerprint - do not modify
    .fingerprint = 0x841cb121b1ce5bcd,

    // Minimum supported Zig version
    .minimum_zig_version = "0.16.0",

    // Dependencies
    .dependencies = .{
        // thread-pool bounded thread pool for parallel operations
        .thread_pool = .{
            .url = "git+https://gitlab.com/devnw/zig/thread-pool.git?ref=v0.2.6#aa4493781d962f42ba1dd37261e0e107be5f6ffe",
            .hash = "thread_pool-0.2.5-11B1BiNceQDdiX2mLCg-blCuvBT0ZHh0_A_gH9j7t2Gl",
        },
    },

    // Files included in the package hash
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "LICENSE",
    },
}
