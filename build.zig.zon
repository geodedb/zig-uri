.{
    // URI/URL parsing and manipulation library for Zig
    // Implements: RFC 3986 (URI), RFC 8141 (URN)
    // Planned: RFC 3987 (IRI), RFC 6874 (IPv6 Zone ID), WHATWG URL Standard
    .name = .uri,

    // Semantic versioning - https://semver.org/
    .version = "0.1.0",

    // Unique package fingerprint - do not modify
    .fingerprint = 0x841cb121b1ce5bcd,

    // Minimum supported Zig version
    .minimum_zig_version = "0.15.1",

    // Dependencies
    .dependencies = .{
        // Spice heartbeat scheduling for parallel operations
        // Pinned to commit bbf106dc8131a514a4d1687cc2173f124f5c8181 on main.
        // TODO: Update to a tagged release when upstream publishes one.
        .spice = .{
            .url = "https://gitlab.com/devnw/zig/spice/-/archive/bbf106dc8131a514a4d1687cc2173f124f5c8181/spice-bbf106dc8131a514a4d1687cc2173f124f5c8181.tar.gz",
            .hash = "spice-0.0.0-HnDb58jJAACojBd1dquGT-Ngc6TORlC6izlAKf0f4Rno",
        },
    },

    // Files included in the package hash
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "LICENSE",
    },
}
